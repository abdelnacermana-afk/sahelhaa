const shuf = a => [...a].sort(() => Math.random() - 0.5);
const _STOP = /\b(اتفاقية|توقيع|معاهدة|إعلان|اعلان|مؤتمر|انعقاد|بداية|نهاية)\b/g;
const _unify = s => s.replace(/[أإآ]/g,'ا').replace(/ى/g,'ي').replace(/ة/g,'ه').replace(/[ؤئء]/g,'');
const norm = s => _unify(s.replace(/[ً-ٰٟ]/g,'')).replace(_STOP,'').replace(/\s+/g,' ').toLowerCase().trim();
const san  = s => s.replace(/[<>&"']/g,'').substring(0,300);
/* تشابه بسيط بين نصين مُبسَّطين (بدون مكتبات) */
function fuzzy(a,b){
  if(!a||!b) return 0;
  const la=a.length, lb=b.length;
  if(!la||!lb) return 0;
  // عدد الحروف المشتركة في نافذة ≤ max(la,lb)/2
  const win=Math.floor(Math.max(la,lb)/2)-1||0;
  const ma=Array(la).fill(false), mb=Array(lb).fill(false);
  let m=0;
  for(let i=0;i<la;i++){
    const lo=Math.max(0,i-win), hi=Math.min(i+win+1,lb);
    for(let j=lo;j<hi;j++) if(!mb[j]&&a[i]===b[j]){ma[i]=mb[j]=true;m++;break;}
  }
  if(!m) return 0;
  let t=0,k=0;
  for(let i=0;i<la;i++) if(ma[i]){while(!mb[k])k++;if(a[i]!==b[k])t++;k++;}
  return (m/la+m/lb+(m-t/2)/m)/3;
}

