function startGame(unit){
  if(S.diff==='hard'){
    _pendingUnit = unit || S.unit || 'dz';
    $('dlg-hard').classList.remove('hidden');
    return;
  }
  _doStartGame(unit);
}
function _doStartGame(unit){  
  clearInterval(TI); 
  TIMEOUT = false;  

  const u = unit || S.unit || 'dz';  
  DATA = UNIT_DATA[u] || UNIT_DATA.dz;  

  const branch = localStorage.getItem('branch');  

  const filteredData = DATA.filter(e => { 
    if (branch === 'literary') return true; 
    return e.branch !== 'literary'; 
  });  

  const shuffled = shuf(filteredData);  

  const used = new Set();  
  const qs = [];  

  for (let i = 0; i < shuffled.length && qs.length < TQ; i++) {  
    const d = shuffled[i];  

    const key = d.event + '|' + d.date;  

    if (used.has(key)) continue;  
    used.add(key);  

    qs.push({  
      d,  
      qt: Math.random() > 0.5 ? 'e2d' : 'd2e',  
      ans: false,  
      ok: false  
    });  
  }  

  S = {  
    diff: S.diff || 'medium',  
    unit: u,  
    score: 0,  
    qi: 0,  
    qs: qs  
  };  

  show('quiz-screen');  
  renderQ();  
}
function restartGame(){ clearInterval(TI); startGame(S.unit); }

function renderQ(){
  TIMEOUT = false;
  const q = S.qs[S.qi];
  $('pfill').style.width = Math.round((S.qi/TQ)*100) + '%';
  renderSteps(S.qi);
  $('sc-disp').textContent = S.score;
  $('q-ctr').textContent = `السؤال ${S.qi+1} / ${TQ}`;
  clearInterval(TI);
  let t=30; setTimer(t);
  TI = setInterval(()=>{ t--; setTimer(t); if(t<=0){ clearInterval(TI); TIMEOUT=true; forceEnd(); } }, 1000);

  const isE2D = q.qt === 'e2d';
  const key = isE2D ? q.d.event : q.d.date;
  const badge = isE2D ? 'حدث ← تاريخ' : 'تاريخ ← حدث';
  const prompt = isE2D ? 'ما هو تاريخ هذا الحدث؟' : 'ما الحدث الذي وقع في هذا التاريخ؟';
  const diffMap = {easy:'سهل', medium:'متوسط', hard:'محترف'};

  /* تنبيه المستوى */
  const hint = $('level-hint');
  if(hint){
    if(S.diff === 'easy' || S.diff === 'medium'){
      hint.textContent = '💡 حاول أن تجيب دون النظر إلى الخيارات.';
      hint.classList.add('vis');
    } else {
      hint.classList.remove('vis');
    }
  }

  let inner = '';
  if(S.diff === 'hard'){
    const exTxt = isE2D
      ? `صيغة التاريخ: <strong>يوم + شهر بالعربية + سنة</strong> — مثال: <strong>1 نوفمبر 1954</strong>`
      : `اكتب اسم الحدث كاملاً بالعربية`;
    inner = `<div class="hard-guide">💡 ${exTxt}</div>
    <div class="cinput-wrap">
      <input class="cinput" id="ci" placeholder="${isE2D?'اكتب تاريخ الحدث...':'اكتب اسم الحدث...'}" autocomplete="off" onkeydown="if(event.key==='Enter')chkTyped()"/>
      <button class="sub-btn" id="sb" onclick="chkTyped()">✔&nbsp; تحقق من الإجابة</button>
    </div>`;
  } else {
    inner = `<div class="choices">${buildChoices(q,isE2D).map(c=>`<button class="cbtn" onclick="chkChoice(this,'${encodeURIComponent(c)}')"><span class="cbtn-ind"></span><span class="cbtn-txt">${c}</span></button>`).join('')}</div>`;
  }

  $('qarea').innerHTML = `
    <div class="qcard" id="qcard">
      <div class="qcard-glow"></div>
      <div class="qmeta">السؤال ${S.qi+1} من ${TQ} &nbsp;·&nbsp; ${diffMap[S.diff]||''}</div>
      <div class="qtype">${badge}</div>
      <div class="qtext">${prompt}<br><span class="qhl">${key}</span></div>
      ${inner}
      <div class="feedback" id="fb"></div>
      <button class="nxt-btn" id="nxt" onclick="nextQ()">السؤال التالي ←</button>
    </div>`;
  if(S.diff==='hard') setTimeout(()=>{ const el=$('ci'); if(el) el.focus(); }, 80);
}

function buildChoices(q, isE2D){
  const d = q.d
  const branch = localStorage.getItem('branch');

  const pool = DATA
  .filter(x => {
    if (branch === 'literary') return true;
    return x.branch !== 'literary';
  })
  .filter(x => x.event !== d.event || x.date !== d.date);
  const correct = isE2D ? d.date : d.event;
  const n = 3;
  let picks = S.diff==='easy'
    ? shuf(pool.filter(x=>Math.abs(x.year-d.year)>=5)).slice(0,n-1)
    : shuf(pool.filter(x=>x.year===d.close[0]||x.year===d.close[1])).slice(0,n-1);
  if(picks.length < n-1) picks = [...picks, ...shuf(pool.filter(x=>!picks.includes(x))).slice(0, n-1-picks.length)];
  return shuf([correct, ...picks.map(x => isE2D?x.date:x.event)]);
}

function chkChoice(btn, enc){
  clearInterval(TI);
  const q = S.qs[S.qi]; if(q.ans) return;
  q.ans = true;
  const val = decodeURIComponent(enc);
  const isE2D = q.qt==='e2d';
  const correct = isE2D ? q.d.date : q.d.event;
  const ok = val === correct;
  q.ok = ok;
  if(ok){ S.score+=10; $('sc-disp').textContent=S.score; }
  document.querySelectorAll('.cbtn').forEach(b=>{
    b.disabled = true;
    const bv = decodeURIComponent(b.getAttribute('onclick').match(/chkChoice\(this,'(.+?)'\)/)[1]);
    if(bv===correct) b.classList.add('correct');
    else if(bv===val&&!ok) b.classList.add('wrong');
  });
  showFB(ok, correct, false);
}

function extractYear(text){
  var m = String(text).match(/\b(1[89][0-9]{2}|20[0-9]{2})\b/);
  return m ? parseInt(m[1], 10) : null;
}

function chkTyped(){
  const inp=$('ci'); if(!inp) return;
  const raw=san(inp.value.trim()); if(!raw) return;
  clearInterval(TI);
  const q=S.qs[S.qi]; if(q.ans) return;
  q.ans=true;
  const isE2D=q.qt==='e2d';
  const correct=isE2D?q.d.date:q.d.event;
  const nr=norm(raw), nc=norm(correct);
  let ok=false, partial=false, close=false;
  if(isE2D){
    const uy=extractYear(raw), cy=extractYear(correct);
    if(!uy || uy!==cy){ ok=false; partial=false; }
    else if(nr===nc){ ok=true; }
    else{ ok=false; partial=true; }
  } else {
    const exact = nr===nc || (nc.includes(nr)&&nr.length>3);
    close = !exact && fuzzy(nr,nc)>=0.82;
    ok = exact || close;
  }
  q.ok = ok || partial;
  inp.disabled=true; const sb=$('sb'); if(sb) sb.disabled=true;
  inp.classList.add(ok?'correct': partial?'partial':'wrong');
  if(ok){ S.score+=15; $('sc-disp').textContent=S.score; }
  else if(partial){ S.score+=7; $('sc-disp').textContent=S.score; }
  showFB(ok, correct, false, close, partial);
}

function showFB(ok, correct, timeout, close, partial){
  const fb=$('fb'), nxt=$('nxt');
  let cls, icon, lbl;
  if(timeout){          cls='timeout'; icon='⏰'; lbl='انتهى الوقت'; }
  else if(partial){     cls='warn';    icon='⚠️'; lbl='إجابة قريبة من الصحيحة (نصف العلامة)'; }
  else if(ok && close){ cls='ok';     icon='✅'; lbl='إجابتك قريبة من الصحيحة 👍'; }
  else if(ok){          cls='ok';     icon='✅'; lbl='إجابة صحيحة'; }
  else{                 cls='ko';     icon='❌'; lbl='إجابة خاطئة'; }
  fb.className = `feedback vis ${cls}`;
  fb.innerHTML = `<div class="fb-icon-wrap">${icon}</div><div class="fb-body"><div class="fb-label">${lbl}</div><div class="fb-ans">الإجابة الصحيحة: <strong>${correct}</strong></div></div>`;
  nxt.classList.add('vis');
  const qc=$('qcard'); if(qc) qc.classList.add(timeout?'state-ko': partial?'state-warn': ok?'state-ok':'state-ko');
}

function forceEnd(){
  const q=S.qs[S.qi];
  if(!q.ans){
    q.ans=true; q.ok=false;
    const correct=q.qt==='e2d'?q.d.date:q.d.event;
    document.querySelectorAll('.cbtn').forEach(b=>b.disabled=true);
    const inp=$('ci'); if(inp){ inp.disabled=true; const sb=$('sb'); if(sb) sb.disabled=true; inp.classList.add('wrong'); }
    showFB(false, correct, true);
  }
}

function nextQ(){
  S.qi++;
  if(S.qi>=TQ){ endGame(); return; }
  renderQ();
}
function normalizeArabicText(text) {
  return text
    .toString()
    .trim()
    .toLowerCase()
    .replace(/[أإآ]/g, "ا");
}

// تحويل اسم الشهر إلى رقم موحد
function getMonthNumber(month) {
  if (!month) return null;

  const m = normalizeArabicText(month);

  const months = {
    "جانفي": 1, "يناير": 1, "جنفي": 1,
    "فيفري": 2, "فبراير": 2, "ففري": 2,
    "مارس": 3, "مرس": 3,
    "افريل": 4, "أفريل": 4, "ابريل": 4, "افرل": 4,
    "ماي": 5, "مايو": 5,
    "جوان": 6, "يونيو": 6,
    "جويلية": 7, "يوليو": 7, "جويلي": 7,
    "اوث": 8, "أوت": 8, "اغسطس": 8, "اغشت": 8, "أغسطس": 8,
    "سبتمبر": 9,
    "اكتوبر": 10, "أكتوبر": 10,
    "نوفمبر": 11, "نفمبر": 11,
    "ديسمبر": 12, "دسمبر": 12,
  };

  return months[m] || null;
}
function normalizeDateNumber(value) {
  if (value === null || value === undefined) return null;

  // تحويل إلى رقم لإزالة الصفر (05 → 5)
  const num = parseInt(value, 10);

  return isNaN(num) ? null : num;
}
/* ═══════════════════════════════════════════
   ERROR CARD SYSTEM — نظام بطاقة الأخطاء
   ✅ ميزة جديدة كاملة — لا تعديل على الكود القديم
═══════════════════════════════════════════ */

var EC_KEY = 'bac_errors_v1';
var _ecOpen = false;

function ecLoad() {
  try { var raw = localStorage.getItem(EC_KEY); return raw ? JSON.parse(raw) : []; }
  catch(e) { return []; }
}
function ecSave(list) {
  try { localStorage.setItem(EC_KEY, JSON.stringify(list)); } catch(e) {}
}
function ecAddError(question, userAnswer, correctAnswer) {
  var list = ecLoad();
  var exists = list.some(function(e){ return e.q===question && e.u===userAnswer && e.c===correctAnswer; });
  if (!exists) {
    list.unshift({ q:question, u:userAnswer, c:correctAnswer, ts:Date.now() });
    if (list.length > 100) list = list.slice(0,100);
    ecSave(list);
  }
  ecUpdateBadge();
  if (_ecOpen) ecRender();
}
function ecDeleteError(idx) {
  var list = ecLoad(); list.splice(idx,1); ecSave(list); ecRender(); ecUpdateBadge();
}
function ecClearAll() {
  $('dlg-confirm-clear').classList.remove('hidden');
}
function ecConfirmClear() {
  $('dlg-confirm-clear').classList.add('hidden');
  ecSave([]); ecRender(); ecUpdateBadge();
}
function ecUpdateBadge() {
  var badge = document.getElementById('ec-badge'); if (!badge) return;
  var list = ecLoad(); badge.textContent = list.length;
  badge.style.background = list.length>0 ? 'rgba(239,68,68,0.18)' : 'rgba(255,255,255,0.06)';
  badge.style.color = list.length>0 ? '#fc8181' : 'var(--text4)';
  badge.style.borderColor = list.length>0 ? 'rgba(239,68,68,0.4)' : 'var(--border)';
}
function ecToggle() {
  _ecOpen = !_ecOpen;
  var body=document.getElementById('ec-body'), toggle=document.getElementById('ec-toggle');
  if(!body||!toggle) return;
  body.classList.toggle('open',_ecOpen); toggle.classList.toggle('open',_ecOpen);
  if (_ecOpen) ecRender();
}
function ecRender() {
  var container=document.getElementById('ec-content'); if(!container) return;
  var list=ecLoad();
  if (list.length===0) {
    container.innerHTML='<div class="error-empty">لا توجد أخطاء مسجلة حتى الآن.<br>استمر في اللعب وستظهر هنا إجاباتك الخاطئة.</div>';
    return;
  }
  var html='<div class="error-list">';
  list.forEach(function(err,i){
    html+='<div class="error-item">'+
      '<div class="error-item-num">'+(i+1)+'</div>'+
      '<div class="error-item-content">'+
        '<div class="error-item-q"><span class="eq-label">السؤال: </span>'+err.q+'</div>'+
        '<div class="error-answers">'+
          '<div class="error-answer-row"><span class="ea-label wrong">إجابتك: </span><span class="ea-val">'+(err.u||'—')+'</span></div>'+
          '<div class="error-answer-row"><span class="ea-label right">الصحيحة: </span><span class="ea-val right-val">'+err.c+'</span></div>'+
        '</div></div>'+
      '<button class="error-del-btn" onclick="ecDeleteError('+i+')">🗑 حذف</button>'+
    '</div>';
  });
  html+='</div><button class="error-clear-all-btn" onclick="ecClearAll()">🗑 حذف جميع الأخطاء ('+list.length+')</button>';
  container.innerHTML=html;
}
(function(){ setTimeout(ecUpdateBadge,100); })();

/* ── Hook على showFB لتسجيل الأخطاء تلقائياً ── */
(function(){
  var _orig = showFB;
  showFB = function(ok, correct, timeout, close, partial) {
    _orig(ok, correct, timeout, close, partial);
    if (!ok || timeout) {
      try {
        var q=S.qs[S.qi]; if(!q) return;
        var isE2D=q.qt==='e2d';
        var questionText=isE2D ? 'ما هو تاريخ: '+q.d.event : 'ما الحدث في: '+q.d.date;
        var userAns=timeout ? 'انتهى الوقت' : (
          S.diff==='hard'
            ? (document.getElementById('ci') ? document.getElementById('ci').value.trim()||'لا إجابة' : 'لا إجابة')
            : (function(){ var w=document.querySelector('.cbtn.wrong .cbtn-txt'); return w?w.textContent:'إجابة خاطئة'; })()
        );
        ecAddError(questionText, userAns, correct);
      } catch(e) {}
    }
  };
})();

function endGame(){
  clearInterval(TI);
  const corr=S.qs.filter(q=>q.ok).length;
  const pct=Math.round((corr/TQ)*100);
  const win=pct>=50;
  $('pfill').style.width='100%'; renderSteps(TQ);
  show('result-screen');
  const ring=$('r-icon');
  ring.textContent = pct>=90?'🏆':pct>=70?'🥇':pct>=50?'🥈':'🎖';
  ring.className='res-ring'+(win?'':' lose');
  $('r-title').className='res-title'+(win?'':' lose');
  $('r-title').textContent = pct>=90?'أسطورة التاريخ!':pct>=70?'ممتاز! مؤرخ بارع':pct>=50?'جيد! واصل التعلم':'حاول مجدداً!';
  $('r-pts').textContent=S.score;
  $('r-stats').innerHTML=`
    <div class="rstat"><div class="rstat-v" style="color:var(--ok)">${corr}</div><div class="rstat-l">إجابة صحيحة</div></div>
    <div class="rstat"><div class="rstat-v" style="color:var(--ko)">${TQ-corr}</div><div class="rstat-l">إجابة خاطئة</div></div>
    <div class="rstat"><div class="rstat-v">${pct}%</div><div class="rstat-l">نسبة النجاح</div></div>`;
  const b=[];
  if(corr===TQ) b.push('🏆 نتيجة مثالية');
  if(S.diff==='hard') b.push('💪 المستوى المحترف');
  if(pct>=80) b.push('⭐ أداء متميز');
  if(S.diff==='medium'&&pct>=70) b.push('🎯 دقة عالية');
  $('r-badges').innerHTML=b.map(x=>`<span class="badge">${x}</span>`).join('');
  try{ localStorage.removeItem('dzprem'); }catch(e){}
}


