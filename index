<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>sahelhaa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════
   DESIGN TOKENS
═══════════════════════════════════════════ */
:root {
  --cw-primary: #1a2744;
  --cw-accent: #c0392b;
  --cw-glow: rgba(192,57,43,0.4);
  --cw-light: #e74c3c;
  --cw-mid: #2c3e60;

  --hi-primary: #1a1206;
  --hi-accent: #d4a017;
  --hi-glow: rgba(212,160,23,0.4);
  --hi-light: #f0c040;
  --hi-mid: #3d2b0a;

  --lm-primary: #0d1f2d;
  --lm-accent: #7c3aed;
  --lm-glow: rgba(124,58,237,0.4);
  --lm-light: #a78bfa;
  --lm-mid: #1e3048;

  --bg: #060910;
  --bg2: #0a0f18;
  --surface: #0f1520;
  --surface2: #162030;
  --surface3: #1c2a3e;
  --border: rgba(255,255,255,0.06);
  --border2: rgba(255,255,255,0.10);
  --border3: rgba(255,255,255,0.17);
  --text: #eef2ff;
  --text2: #9badc8;
  --text3: #526070;
  --text4: #334455;

  --ok: #22c55e;
  --ko: #ef4444;
  --warn: #f59e0b;
  --ok-bg: rgba(34,197,94,0.10);
  --ko-bg: rgba(239,68,68,0.10);

  --ease: cubic-bezier(.4,0,.2,1);
  --bounce: cubic-bezier(.34,1.56,.64,1);
  --r-sm: 10px;
  --r-md: 16px;
  --r-lg: 22px;
  --r-xl: 28px;

  /* Grain overlay opacity */
  --grain: 0.025;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  font-family: 'Tajawal', 'Cairo', sans-serif;
  background: var(--bg);
  color: var(--text);
  direction: rtl;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ── Rich background: mesh + subtle grid ── */
body::before {
  content: '';
  position: fixed; inset: 0;
  background:
    radial-gradient(ellipse 70% 55% at 15% 10%, rgba(26,39,68,0.55) 0%, transparent 65%),
    radial-gradient(ellipse 55% 45% at 85% 85%, rgba(124,58,237,0.15) 0%, transparent 60%),
    radial-gradient(ellipse 40% 35% at 50% 50%, rgba(192,57,43,0.08) 0%, transparent 70%);
  pointer-events: none; z-index: 0;
}
body::after {
  content: '';
  position: fixed; inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
  background-size: 44px 44px;
  pointer-events: none; z-index: 0;
}

#app {
  max-width: 820px;
  margin: 0 auto;
  padding: 1.5rem 1.25rem 6rem;
  position: relative;
  z-index: 1;
}

/* ═══ SCREENS ═══ */
.screen { display: none; animation: screenIn 0.45s var(--ease) both; }
.screen.active { display: block; }

@keyframes screenIn  { from { opacity:0; transform:translateY(20px) scale(0.985); } to { opacity:1; transform:none; } }
@keyframes screenOut { from { opacity:1; } to { opacity:0; transform:translateY(-12px); } }
@keyframes floatY    { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-9px)} }
@keyframes pulseGlow { 0%,100%{opacity:0.45} 50%{opacity:1} }
@keyframes shimmer   { 0%{background-position:-200% 0} 100%{background-position:200% 0} }
@keyframes popIn     { 0%{transform:scale(0.9)} 60%{transform:scale(1.05)} 100%{transform:scale(1)} }
@keyframes shakeX    { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-7px)} 40%{transform:translateX(7px)} 60%{transform:translateX(-4px)} 80%{transform:translateX(3px)} }
@keyframes ringIn    { 0%{transform:scale(0.1) rotate(-180deg);opacity:0} 65%{transform:scale(1.1) rotate(5deg)} 100%{transform:scale(1) rotate(0);opacity:1} }
@keyframes fadeUp    { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:none} }
@keyframes gradPulse { 0%,100%{opacity:0.55} 50%{opacity:1} }
@keyframes dotPulse  { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.7);opacity:0.4} }
@keyframes borderGlow { 0%,100%{opacity:0.5} 50%{opacity:1} }

/* ═══ TOP BAR ═══ */
.topbar {
  width: 100%;
  position: sticky; top: 0; left: 0; right: 0;
  background: rgba(6,9,16,0.88);
  backdrop-filter: blur(24px) saturate(1.4);
  -webkit-backdrop-filter: blur(24px) saturate(1.4);
  border-bottom: 1px solid rgba(255,255,255,0.07);
  z-index: 100;
  padding: 0; margin: 0;
}
.topbar::after {
  content: '';
  position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(212,160,23,0.4) 40%, rgba(192,57,43,0.3) 60%, transparent);
  animation: borderGlow 4s ease-in-out infinite;
}
.topbar-inner {
  display: flex; justify-content: space-between; align-items: center;
  padding: 0.9rem 2rem;
  max-width: 1200px; margin: 0 auto; width: 100%;
}

.brand {
  display: flex; align-items: center; gap: 12px;
  cursor: pointer; user-select: none;
  transition: opacity 0.2s;
}
.brand:hover { opacity: 0.82; }

.brand-emblem {
  width: 40px; height: 40px; border-radius: 12px;
  background: linear-gradient(135deg, #1a2744 0%, #c0392b 100%);
  border: 1px solid rgba(255,255,255,0.13);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.05rem;
  box-shadow: 0 0 20px rgba(192,57,43,0.35), inset 0 1px 0 rgba(255,255,255,0.1);
}

.brand-text { display: flex; flex-direction: column; gap: 1px; }
.brand-title { font-size: 0.85rem; font-weight: 800; color: var(--text); letter-spacing: -0.3px; }
.brand-sub   { font-size: 0.61rem; color: var(--text3); font-weight: 600; letter-spacing: 0.2px; }

.topbar-right { display: flex; gap: 8px; align-items: center; }

.nav-btn {
  background: var(--surface2);
  border: 1px solid var(--border2);
  border-radius: var(--r-sm);
  padding: 7px 16px;
  font-family: 'Tajawal', sans-serif;
  font-size: 0.76rem; font-weight: 700;
  color: var(--text2); cursor: pointer;
  transition: all 0.2s var(--ease);
  display: flex; align-items: center; gap: 6px;
}
.nav-btn:hover {
  background: var(--surface3); border-color: var(--border3);
  color: var(--text); transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(0,0,0,0.3);
}
.nav-btn:active { transform: scale(0.97); }

/* ═══ HOME HERO ═══ */
.home-hero {
  text-align: center;
  padding: 3.5rem 0 3.5rem;
  position: relative;
}

.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  background: linear-gradient(135deg, rgba(212,160,23,0.08), rgba(192,57,43,0.06));
  border: 1px solid rgba(212,160,23,0.2);
  border-radius: 40px;
  padding: 6px 20px;
  font-size: 0.72rem; font-weight: 700;
  color: rgba(212,160,23,0.9);
  margin-bottom: 1.6rem;
  letter-spacing: 0.6px;
  text-transform: uppercase;
}
.eyebrow-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--ok);
  box-shadow: 0 0 8px rgba(34,197,94,0.7);
  animation: dotPulse 2.2s infinite;
}

.hero-h1 {
  font-size: 2.8rem; font-weight: 900;
  line-height: 1.08; margin-bottom: 0.8rem;
  letter-spacing: -0.8px;
}
.hero-h1 .line1 { color: var(--text); display: block; }
.hero-h1 .line2 {
  display: block;
  background: linear-gradient(135deg, #d4a017 0%, #f0c040 40%, #e8a020 70%, #d4a017 100%);
  background-size: 200% auto;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer 3.5s linear infinite;
}

.hero-p {
  font-size: 0.85rem; color: var(--text2); line-height: 2;
  max-width: 380px; margin: 0 auto 0.4rem;
  font-weight: 500;
}
.hero-sub {
  font-size: 0.82rem; color: var(--text2);
  margin-bottom: 3rem; letter-spacing: 0.2px;
  font-weight: 500;
}

/* ═══ STATS ROW ═══ */
.stats-row {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 14px; margin-bottom: 3rem; width: 100%;
}
.stat-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 1.3rem 1rem;
  text-align: center;
  transition: all 0.28s var(--ease);
  position: relative; overflow: hidden;
}
.stat-card::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, #c0392b, #d4a017, #7c3aed);
  opacity: 0; transition: opacity 0.3s;
}
.stat-card::after {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at 50% 0%, rgba(212,160,23,0.04), transparent 65%);
  opacity: 0; transition: opacity 0.3s;
}
.stat-card:hover::before,
.stat-card:hover::after { opacity: 1; }
.stat-card:hover { border-color: var(--border3); transform: translateY(-3px); box-shadow: 0 8px 28px rgba(0,0,0,0.35); }
.stat-v {
  font-size: 2rem; font-weight: 900; line-height: 1;
  margin-bottom: 0.35rem;
  background: linear-gradient(135deg, #f0f4ff, #c8d4f0);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.stat-l { font-size: 0.64rem; color: var(--text3); font-weight: 700; letter-spacing: 0.4px; }

/* ═══ SECTION DIVIDER ═══ */
.section-divider {
  display: flex; align-items: center; gap: 14px;
  margin-bottom: 1.5rem;
}
.sdiv-line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--border2), transparent); }
.sdiv-txt {
  font-size: 0.63rem; font-weight: 800;
  color: var(--text3); letter-spacing: 1.8px;
  white-space: nowrap; text-transform: uppercase;
  padding: 4px 12px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: var(--surface);
}

/* ═══ UNIT CARDS ═══ */
.units-grid {
  display: grid; gap: 16px; margin-bottom: 2.5rem;
}

.ucard {
  border-radius: var(--r-xl);
  border: 1px solid var(--border);
  position: relative; overflow: hidden; cursor: pointer;
  transition: all 0.32s var(--ease);
  min-height: 210px;
}
.ucard::after {
  content: '';
  position: absolute; inset: 0;
  border-radius: var(--r-xl);
  border: 1px solid transparent;
  transition: border-color 0.3s;
  pointer-events: none; z-index: 5;
}
.ucard:hover { transform: translateY(-6px) scale(1.012); }
.ucard:active { transform: scale(0.972); }

.ucard-img {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
  opacity: 0.14; transition: opacity 0.45s;
  filter: saturate(0.5) blur(0.5px);
}
.ucard:hover .ucard-img { opacity: 0.24; }

/* صورة غاندي — التركيز على الوجه (أعلى الصورة) */
#img-lm { background-position: top center; }

.ucard-overlay { position: absolute; inset: 0; z-index: 1; }

.ucard-inner {
  position: relative; z-index: 2;
  padding: 1.6rem 1.4rem;
  height: 100%; display: flex; flex-direction: column;
}

/* Cold War Card */
.ucard-cw { border-color: rgba(192,57,43,0.25); background: linear-gradient(160deg, rgba(14,22,44,0.95), rgba(10,15,25,0.95)); }
.ucard-cw .ucard-overlay { background: linear-gradient(155deg, rgba(26,39,68,0.7) 0%, rgba(192,57,43,0.18) 100%); }
.ucard-cw:hover { border-color: rgba(231,76,60,0.55); box-shadow: 0 16px 48px var(--cw-glow), 0 4px 16px rgba(0,0,0,0.5); }
.ucard-cw:hover::after { border-color: rgba(231,76,60,0.2); }

/* History Card */
.ucard-hi { border-color: rgba(212,160,23,0.22); background: linear-gradient(160deg, rgba(20,14,6,0.95), rgba(10,8,3,0.95)); }
.ucard-hi .ucard-overlay { background: linear-gradient(155deg, rgba(30,20,5,0.7) 0%, rgba(212,160,23,0.18) 100%); }
.ucard-hi:hover { border-color: rgba(212,160,23,0.55); box-shadow: 0 16px 48px var(--hi-glow), 0 4px 16px rgba(0,0,0,0.5); }
.ucard-hi:hover::after { border-color: rgba(212,160,23,0.2); }

/* Liberation Card */
.ucard-lm { border-color: rgba(124,58,237,0.22); background: linear-gradient(160deg, rgba(10,16,28,0.95), rgba(8,12,20,0.95)); }
.ucard-lm .ucard-overlay { background: linear-gradient(155deg, rgba(13,25,45,0.7) 0%, rgba(124,58,237,0.18) 100%); }
.ucard-lm:hover { border-color: rgba(124,58,237,0.55); box-shadow: 0 16px 48px var(--lm-glow), 0 4px 16px rgba(0,0,0,0.5); }
.ucard-lm:hover::after { border-color: rgba(124,58,237,0.2); }

.ucard-number {
  font-size: 0.58rem; font-weight: 900;
  letter-spacing: 2.5px; opacity: 0.75;
  margin-bottom: 1rem; text-transform: uppercase;
}
.ucard-cw .ucard-number { color: #e74c3c; }
.ucard-hi .ucard-number { color: #d4a017; }
.ucard-lm .ucard-number { color: #a78bfa; }

.ucard-icon-wrap {
  width: 48px; height: 48px; border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.4rem; margin-bottom: 1rem;
  transition: transform 0.3s var(--bounce);
}
.ucard:hover .ucard-icon-wrap { transform: scale(1.15) rotate(-6deg); }
.ucard-cw .ucard-icon-wrap { background: rgba(192,57,43,0.14); border: 1px solid rgba(231,76,60,0.35); box-shadow: 0 4px 12px rgba(192,57,43,0.2); }
.ucard-hi .ucard-icon-wrap { background: rgba(212,160,23,0.14); border: 1px solid rgba(212,160,23,0.35); box-shadow: 0 4px 12px rgba(212,160,23,0.2); }
.ucard-lm .ucard-icon-wrap { background: rgba(124,58,237,0.14); border: 1px solid rgba(124,58,237,0.35); box-shadow: 0 4px 12px rgba(124,58,237,0.2); }

.ucard-title { font-size: 1.12rem; font-weight: 900; margin-bottom: 0.4rem; line-height: 1.2; }
.ucard-cw .ucard-title { color: #f6a09a; }
.ucard-hi .ucard-title { color: #f4cc5a; }
.ucard-lm .ucard-title { color: #c8b4fd; }
.ucard-sub { font-size: 0.69rem; color: var(--text3); line-height: 1.7; margin-top: auto; }

/* ═══ BACK BUTTON ═══ */
.back-btn {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--surface); border: 1px solid var(--border2);
  border-radius: var(--r-sm); padding: 8px 16px;
  font-size: 0.78rem; font-family: 'Tajawal', sans-serif;
  color: var(--text2); font-weight: 700; cursor: pointer;
  margin-bottom: 1.75rem; transition: all 0.2s var(--ease);
}
.back-btn:hover { background: var(--surface2); border-color: var(--border3); color: var(--text); transform: translateX(3px); }

/* ═══ UNIT SELECT SCREEN ═══ */
.unit-hero {
  border-radius: var(--r-xl); overflow: hidden;
  margin-bottom: 2rem; position: relative;
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
}
.unit-hero-bg {
  padding: 2.25rem 2rem;
  display: flex; align-items: center; gap: 18px;
  position: relative; overflow: hidden;
}
.unit-hero-img {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
  opacity: 0.1; filter: saturate(0.4) blur(1px);
}
.unit-hero-overlay { position: absolute; inset: 0; }

.uhero-hi { border: 1px solid rgba(212,160,23,0.4); }
.uhero-hi .unit-hero-overlay { background: linear-gradient(135deg, rgba(28,18,6,0.97), rgba(212,160,23,0.5)); }
.uhero-hi .unit-hero-icon { background: rgba(212,160,23,0.16); border-color: rgba(212,160,23,0.45); }
.uhero-hi .unit-hero-title { color: #f4cc5a; }

.unit-hero-icon {
  width: 64px; height: 64px; border-radius: 18px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.9rem; flex-shrink: 0;
  border: 1px solid;
  animation: floatY 3.8s ease-in-out infinite;
  position: relative; z-index: 2;
  box-shadow: 0 6px 20px rgba(0,0,0,0.3);
}
.unit-hero-info { flex: 1; position: relative; z-index: 2; }
.unit-hero-title { font-size: 1.45rem; font-weight: 900; margin-bottom: 0.4rem; line-height: 1.1; }
.unit-hero-meta {
  display: flex; gap: 16px; flex-wrap: wrap;
  font-size: 0.72rem; color: rgba(255,255,255,0.55);
}
.uhm-dot { display: inline-block; width: 4px; height: 4px; border-radius: 50%; background: var(--text3); vertical-align: middle; margin-left: 6px; }

/* ═══ DIFFICULTY CARDS ═══ */
.diff-label {
  font-size: 0.66rem; font-weight: 800; color: var(--text3);
  letter-spacing: 1.6px; text-align: center;
  margin-bottom: 1rem; text-transform: uppercase;
}
.diff-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 1.75rem; }

.dcard {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-md); padding: 1.25rem 1rem;
  cursor: pointer; text-align: center;
  transition: all 0.25s var(--ease);
  position: relative; overflow: hidden;
}
.dcard::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
}
.dcard:hover { border-color: var(--border3); transform: translateY(-4px); background: var(--surface2); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
.dcard.picked { border-color: rgba(212,160,23,0.5); background: rgba(212,160,23,0.05); box-shadow: 0 0 20px rgba(212,160,23,0.1); }
.dcard-check { position: absolute; top: 8px; left: 8px; width: 18px; height: 18px; border-radius: 50%; background: var(--hi-accent); display: none; align-items: center; justify-content: center; font-size: 0.58rem; color: #000; font-weight: 900; box-shadow: 0 2px 8px rgba(212,160,23,0.4); }
.dcard.picked .dcard-check { display: flex; }
.dcard-dot { width: 14px; height: 14px; border-radius: 50%; margin: 0 auto 0.75rem; border: 2px solid; }
.d-easy { border-color: var(--ok); background: rgba(34,197,94,0.18); box-shadow: 0 0 10px rgba(34,197,94,0.15); }
.d-med  { border-color: var(--warn); background: rgba(245,158,11,0.18); box-shadow: 0 0 10px rgba(245,158,11,0.15); }
.d-hard { border-color: var(--ko); background: rgba(239,68,68,0.18); box-shadow: 0 0 10px rgba(239,68,68,0.15); }
.dcard-title { font-size: 0.92rem; font-weight: 800; color: var(--text); margin-bottom: 0.3rem; }
.dcard.picked .dcard-title { color: var(--hi-accent); }
.dcard-desc { font-size: 0.65rem; color: var(--text3); line-height: 1.7; }

.start-btn {
  width: 100%; border: none; border-radius: var(--r-lg);
  padding: 1.05rem; font-size: 1rem; font-weight: 800;
  font-family: 'Tajawal', sans-serif; color: #fff; cursor: pointer;
  transition: all 0.25s; letter-spacing: 0.3px;
  background: linear-gradient(135deg, #d4a017, #b07010);
  box-shadow: 0 6px 28px rgba(212,160,23,0.35);
  position: relative; overflow: hidden;
}
.start-btn::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
  opacity: 0; transition: opacity 0.25s;
}
.start-btn:hover::before { opacity: 1; }
.start-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 36px rgba(212,160,23,0.5); }
.start-btn:active { transform: scale(0.98); }

.start-btn-cw { background: linear-gradient(135deg, #c0392b, #8b2015); box-shadow: 0 6px 28px rgba(192,57,43,0.35); }
.start-btn-cw:hover { box-shadow: 0 10px 36px rgba(192,57,43,0.5); }
.start-btn-lm { background: linear-gradient(135deg, #7c3aed, #5318c2); box-shadow: 0 6px 28px rgba(124,58,237,0.35); }
.start-btn-lm:hover { box-shadow: 0 10px 36px rgba(124,58,237,0.5); }

/* ═══ QUIZ SCREEN ═══ */
.quiz-topbar {
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: 8px; margin-bottom: 1.25rem;
}
.q-chip {
  border-radius: 30px; padding: 6px 16px;
  font-size: 0.75rem; font-weight: 700;
  font-family: 'Tajawal', sans-serif;
  display: inline-flex; align-items: center; gap: 6px;
}
.qc-score { background: rgba(212,160,23,0.1); border: 1px solid rgba(212,160,23,0.28); color: #f0c040; }
.qc-count { background: var(--surface); border: 1px solid var(--border2); color: var(--text2); }
.qc-timer { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.28); color: #fc8181; }
.qc-timer.warn { background: rgba(245,158,11,0.1); border-color: rgba(245,158,11,0.38); color: var(--warn); animation: gradPulse 1s infinite; }

/* Progress */
.pbar-wrap { margin-bottom: 0.75rem; }
.pbar { height: 6px; background: var(--surface2); border-radius: 4px; overflow: hidden; }
.pfill {
  height: 100%; border-radius: 4px;
  background: linear-gradient(90deg, #c0392b, #d4a017, #7c3aed);
  background-size: 200% auto;
  transition: width 0.65s var(--ease);
  animation: shimmer 4s linear infinite;
}
.psteps { display: flex; gap: 4px; margin-top: 6px; }
.pstep { flex: 1; height: 3px; border-radius: 2px; background: var(--surface2); transition: background 0.35s; }
.pstep.done { background: rgba(212,160,23,0.45); }
.pstep.cur  { background: var(--hi-accent); box-shadow: 0 0 6px rgba(212,160,23,0.5); }

/* Question Card */
.qcard {
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: var(--r-xl);
  padding: 2rem 1.75rem;
  margin-bottom: 1rem;
  position: relative; overflow: hidden;
  transition: border-color 0.4s, box-shadow 0.4s;
  box-shadow: 0 4px 24px rgba(0,0,0,0.3);
}
.qcard::before {
  content: ''; position: absolute;
  top: 0; right: 0; left: 0; height: 2px;
  background: linear-gradient(90deg, #c0392b, #d4a017 45%, #7c3aed);
}
.qcard-glow {
  position: absolute; top: -50px; right: -50px;
  width: 160px; height: 160px; border-radius: 50%;
  background: radial-gradient(circle, rgba(212,160,23,0.05), transparent 70%);
  pointer-events: none;
}
.qcard.state-ok { border-color: rgba(34,197,94,0.45); background: rgba(34,197,94,0.03); box-shadow: 0 4px 24px rgba(34,197,94,0.08); }
.qcard.state-ko { border-color: rgba(239,68,68,0.45); background: rgba(239,68,68,0.03); box-shadow: 0 4px 24px rgba(239,68,68,0.08); }
.qcard.state-warn { border-color: rgba(245,158,11,0.45); background: rgba(245,158,11,0.03); box-shadow: 0 4px 24px rgba(245,158,11,0.08); }

.qmeta   { font-size: 0.68rem; color: var(--text3); font-weight: 700; letter-spacing: 0.6px; margin-bottom: 0.6rem; text-transform: uppercase; }
.qtype   { display: inline-flex; align-items: center; background: var(--surface2); border: 1px solid var(--border2); border-radius: 8px; padding: 3px 11px; font-size: 0.67rem; color: var(--text2); font-weight: 700; margin-bottom: 1.1rem; }
.qtext   { font-size: 1.08rem; font-weight: 700; line-height: 2; color: var(--text); margin-bottom: 1.25rem; }
.qhl     {
  color: #f4cc5a; font-weight: 900;
  background: rgba(212,160,23,0.09);
  border-radius: 8px; padding: 3px 10px;
  border: 1px solid rgba(212,160,23,0.22);
  box-shadow: 0 0 14px rgba(212,160,23,0.08);
}

/* Choices */
.choices { display: grid; gap: 10px; }
.cbtn {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--r-md); padding: 1rem 1.2rem;
  font-size: 0.88rem; font-family: 'Tajawal', sans-serif;
  cursor: pointer; text-align: right; direction: rtl;
  color: var(--text2); font-weight: 600; line-height: 1.65;
  display: flex; align-items: center; gap: 12px;
  transition: all 0.2s var(--ease);
}
.cbtn:not(:disabled):hover {
  border-color: rgba(212,160,23,0.45); color: var(--text);
  transform: translateX(-4px); background: rgba(212,160,23,0.04);
  box-shadow: 0 4px 16px rgba(0,0,0,0.2);
}
.cbtn:disabled { cursor: default; }
.cbtn-ind {
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--surface3); border: 1.5px solid var(--border2);
  flex-shrink: 0; transition: all 0.2s; order: 1;
}
.cbtn-txt  { flex: 1; order: 2; text-align: right; }
.cbtn:not(:disabled):hover .cbtn-ind { background: #d4a017; border-color: #d4a017; box-shadow: 0 0 8px rgba(212,160,23,0.4); }
.cbtn.correct { background: var(--ok-bg); border-color: rgba(34,197,94,0.45); animation: popIn 0.4s var(--ease); box-shadow: 0 0 16px rgba(34,197,94,0.06); }
.cbtn.correct .cbtn-txt { color: #4ade80; font-weight: 700; }
.cbtn.correct .cbtn-ind { background: var(--ok); border-color: var(--ok); box-shadow: 0 0 8px rgba(34,197,94,0.5); }
.cbtn.wrong   { background: var(--ko-bg); border-color: rgba(239,68,68,0.42); animation: shakeX 0.4s; }
.cbtn.wrong .cbtn-txt { color: #fc8181; }
.cbtn.wrong .cbtn-ind { background: var(--ko); border-color: var(--ko); }

/* Hard mode */
.hard-guide {
  background: var(--surface2); border: 1px solid var(--border2);
  border-right: 3px solid #d4a017;
  border-radius: 0 var(--r-md) var(--r-md) 0;
  padding: 0.9rem 1.2rem; margin-bottom: 1rem;
  font-size: 0.79rem; color: var(--text2); line-height: 2;
}
.hard-guide strong { color: #f4cc5a; font-weight: 800; }
.cinput-wrap { display: flex; flex-direction: column; gap: 10px; }
.cinput {
  background: var(--surface2); border: 1px solid var(--border2);
  border-radius: var(--r-md); padding: 1rem 1.2rem;
  font-size: 0.92rem; font-family: 'Tajawal', sans-serif;
  direction: rtl; color: var(--text); outline: none; width: 100%;
  transition: all 0.22s;
}
.cinput::placeholder { color: var(--text4); }
.cinput:focus { border-color: rgba(212,160,23,0.55); background: rgba(212,160,23,0.03); box-shadow: 0 0 0 3px rgba(212,160,23,0.07); }
.cinput.correct { border-color: var(--ok); background: var(--ok-bg); color: #4ade80; }
.cinput.wrong   { border-color: var(--ko); background: var(--ko-bg); color: #fc8181; }
.cinput.partial { border-color: var(--warn); background: rgba(245,158,11,0.08); color: #fbbf24; }
.sub-btn {
  background: linear-gradient(135deg, #d4a017, #b07010);
  color: #fff; border: none; border-radius: var(--r-md);
  padding: 0.95rem; font-size: 0.92rem; font-weight: 800;
  font-family: 'Tajawal', sans-serif; cursor: pointer; transition: all 0.22s;
  box-shadow: 0 4px 16px rgba(212,160,23,0.25);
}
.sub-btn:hover { box-shadow: 0 6px 22px rgba(212,160,23,0.4); transform: translateY(-1px); }
.sub-btn:active { transform: scale(0.97); }
.sub-btn:disabled { background: var(--surface3); color: var(--text4); cursor: default; box-shadow: none; transform: none; }

/* Feedback */
.feedback {
  display: none; border-radius: var(--r-md);
  padding: 1rem 1.2rem; margin-top: 0.9rem;
  font-size: 0.86rem; font-weight: 700; line-height: 1.9;
  border: 1px solid transparent;
  animation: fadeUp 0.3s var(--ease);
  align-items: center; gap: 12px;
}
.feedback.vis { display: flex; }
.fb-icon-wrap { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
.feedback.ok  { background: var(--ok-bg); border-color: rgba(34,197,94,0.25); }
.feedback.ok .fb-icon-wrap { background: rgba(34,197,94,0.18); }
.feedback.ko  { background: var(--ko-bg); border-color: rgba(239,68,68,0.25); }
.feedback.ko .fb-icon-wrap { background: rgba(239,68,68,0.18); }
.feedback.timeout { background: rgba(245,158,11,0.08); border-color: rgba(245,158,11,0.25); }
.feedback.timeout .fb-icon-wrap { background: rgba(245,158,11,0.18); }
.feedback.warn  { background: rgba(245,158,11,0.08); border-color: rgba(245,158,11,0.35); }
.feedback.warn .fb-icon-wrap { background: rgba(245,158,11,0.22); }
.fb-label { font-size: 0.92rem; font-weight: 800; margin-bottom: 0.2rem; }
.feedback.ok .fb-label { color: #4ade80; }
.feedback.ko .fb-label { color: #fc8181; }
.feedback.timeout .fb-label { color: var(--warn); }
.feedback.warn .fb-label { color: var(--warn); font-weight: 800; }
.fb-ans { font-size: 0.79rem; color: var(--text2); font-weight: 600; }
.fb-ans strong { color: var(--text); }

.nxt-btn {
  display: none; width: 100%; background: var(--surface2);
  border: 1px solid var(--border2); border-radius: var(--r-md);
  padding: 0.9rem; font-size: 0.92rem; font-weight: 700;
  font-family: 'Tajawal', sans-serif; color: var(--text2); cursor: pointer;
  transition: all 0.22s; margin-top: 0.75rem;
}
.nxt-btn.vis { display: block; animation: fadeUp 0.3s 0.08s both; }
.nxt-btn:hover { background: var(--surface3); color: var(--text); border-color: var(--border3); box-shadow: 0 4px 16px rgba(0,0,0,0.2); }

/* ═══ RESULT SCREEN ═══ */
.result-wrap { padding: 1.25rem 0 2.5rem; }
.res-card {
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: var(--r-xl);
  padding: 3rem 2.25rem;
  text-align: center;
  box-shadow: 0 8px 40px rgba(0,0,0,0.4);
  position: relative; overflow: hidden;
}
.res-card::before {
  content: ''; position: absolute;
  top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, #c0392b, #d4a017 45%, #7c3aed);
}
.res-ring {
  font-size: 4.5rem; display: block; margin-bottom: 0.85rem;
  animation: ringIn 0.7s var(--bounce) both;
  filter: drop-shadow(0 4px 12px rgba(212,160,23,0.3));
}
.res-title {
  font-size: 1.9rem; font-weight: 900; color: var(--text);
  margin-bottom: 0.6rem;
  animation: fadeUp 0.5s 0.2s var(--ease) both;
}
.res-title.lose { color: #fc8181; }
.res-pts {
  font-size: 3.4rem; font-weight: 900;
  background: linear-gradient(135deg, #d4a017, #f0c040);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: fadeUp 0.5s 0.25s var(--ease) both;
  filter: drop-shadow(0 2px 8px rgba(212,160,23,0.2));
}
.res-pts-lbl { font-size: 0.78rem; color: var(--text3); font-weight: 700; margin-bottom: 1.75rem; animation: fadeUp 0.5s 0.3s var(--ease) both; letter-spacing: 0.3px; }
.res-stats {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
  margin-bottom: 1.75rem;
  animation: fadeUp 0.5s 0.35s var(--ease) both;
}
.rstat {
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: var(--r-md); padding: 1rem 0.5rem;
}
.rstat-v { font-size: 1.6rem; font-weight: 900; margin-bottom: 0.25rem; }
.rstat-l { font-size: 0.63rem; color: var(--text3); font-weight: 700; letter-spacing: 0.3px; }
.badges-row { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 1.75rem; animation: fadeUp 0.5s 0.4s var(--ease) both; }
.badge {
  background: var(--surface2); border: 1px solid var(--border2);
  border-radius: 30px; padding: 5px 14px;
  font-size: 0.71rem; font-weight: 700; color: var(--text2);
}
.res-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; animation: fadeUp 0.5s 0.45s var(--ease) both; }
.rbtn { border: none; border-radius: var(--r-md); padding: 0.9rem; font-size: 0.9rem; font-weight: 800; font-family: 'Tajawal', sans-serif; cursor: pointer; transition: all 0.22s; }
.rbtn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.3); }
.rbtn:active { transform: scale(0.97); }
.rbtn-primary { background: linear-gradient(135deg, #d4a017, #c0392b); color: #fff; box-shadow: 0 5px 22px rgba(192,57,43,0.25); }
.rbtn-secondary { background: var(--surface2); border: 1px solid var(--border2); color: var(--text2); }


/* ═══════════════════════════════════════════
   LIGHT MODE — نظام ألوان احترافي عالي التباين
   هدف: قراءة مثالية كورقة امتحان
═══════════════════════════════════════════ */
body.light-mode {
  /* ── Tokens ── */
  --bg:       #f2f4f8;
  --bg2:      #e8ecf3;
  --surface:  #ffffff;
  --surface2: #f7f8fb;
  --surface3: #edf0f6;

  --border:  rgba(15, 30, 70, 0.12);
  --border2: rgba(15, 30, 70, 0.20);
  --border3: rgba(15, 30, 70, 0.32);

  /* نصوص عالية التباين — لا رمادي فاتح */
  --text:  #0d1b36;   /* كحلي داكن جداً  — ratio 15:1 على أبيض */
  --text2: #253559;   /* كحلي متوسط      — ratio  9:1 */
  --text3: #3d5080;   /* كحلي فاتح مقروء — ratio  6:1 */
  --text4: #5a6f99;   /* ثانوي            — ratio  4.5:1 */

  --ok-bg: rgba(21, 128, 61, 0.10);
  --ko-bg: rgba(185, 28, 28, 0.10);
}

/* ═══ قواعد الوضع النهاري ═══ */

/* الجسم والخلفية */
body.light-mode {
  background: var(--bg);
  color: var(--text);
}
body.light-mode::before,
body.light-mode::after { display: none; }

/* ── شريط التنقل ── */
body.light-mode .topbar {
  background: rgba(255,255,255,0.96);
  border-bottom: 1.5px solid var(--border2);
  box-shadow: 0 2px 14px rgba(13,27,54,0.09);
}
body.light-mode .topbar::after { opacity: 0.4; }
body.light-mode .brand-title { color: var(--text); }
body.light-mode .brand-sub   { color: var(--text3); }
body.light-mode .nav-btn {
  background: var(--surface2);
  border-color: var(--border2);
  color: var(--text2);
}
body.light-mode .nav-btn:hover {
  background: var(--surface3);
  border-color: var(--border3);
  color: var(--text);
  box-shadow: 0 3px 12px rgba(13,27,54,0.12);
}

/* ── Hero ── */
body.light-mode .hero-eyebrow {
  background: linear-gradient(135deg, rgba(180,100,10,0.10), rgba(160,40,30,0.07));
  border-color: rgba(160,60,20,0.28);
  color: #7a3810;
}
body.light-mode .hero-h1 .line1 { color: var(--text); }
body.light-mode .hero-p   { color: var(--text3); }
body.light-mode .hero-sub { color: var(--text3); }

/* ── بطاقات الإحصائيات ── */
body.light-mode .stat-card {
  background: #ffffff;
  border: 1.5px solid var(--border2);
  box-shadow: 0 2px 12px rgba(13,27,54,0.08);
}
body.light-mode .stat-card:hover {
  border-color: var(--border3);
  box-shadow: 0 6px 22px rgba(13,27,54,0.13);
  transform: translateY(-3px);
}
body.light-mode .stat-v {
  background: linear-gradient(135deg, #0d1b36, #253559);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
body.light-mode .stat-l { color: var(--text3); }

/* ── فاصل الأقسام ── */
body.light-mode .sdiv-line { background: linear-gradient(90deg, transparent, var(--border2), transparent); }
body.light-mode .sdiv-txt  {
  background: #ffffff;
  color: var(--text3);
  border-color: var(--border2);
}

/* ═══ بطاقات الوحدات — الأهم ═══ */
body.light-mode .ucard {
  box-shadow: 0 3px 16px rgba(13,27,54,0.10);
  border-width: 1.5px;
}
body.light-mode .ucard:hover {
  transform: translateY(-6px) scale(1.012);
  box-shadow: 0 12px 36px rgba(13,27,54,0.16);
}
/* خلفيات البطاقات — فاتحة ومميزة */
body.light-mode .ucard-cw {
  background: linear-gradient(155deg, #fff5f5 0%, #ffe8e6 100%);
  border-color: rgba(192,57,43,0.30);
}
body.light-mode .ucard-cw .ucard-overlay {
  background: linear-gradient(155deg, rgba(255,240,238,0.5) 0%, rgba(192,57,43,0.06) 100%);
}
body.light-mode .ucard-cw:hover { border-color: rgba(192,57,43,0.55); box-shadow: 0 12px 36px rgba(192,57,43,0.18); }
body.light-mode .ucard-cw .ucard-title  { color: #7a1a10; }
body.light-mode .ucard-cw .ucard-number { color: #b03020; opacity: 0.75; }
body.light-mode .ucard-cw .ucard-icon-wrap { background: rgba(192,57,43,0.10); border-color: rgba(192,57,43,0.30); }

body.light-mode .ucard-hi {
  background: linear-gradient(155deg, #fffbee 0%, #fff3cc 100%);
  border-color: rgba(180,130,10,0.28);
}
body.light-mode .ucard-hi .ucard-overlay {
  background: linear-gradient(155deg, rgba(255,252,235,0.5) 0%, rgba(212,160,23,0.06) 100%);
}
body.light-mode .ucard-hi:hover { border-color: rgba(180,130,10,0.55); box-shadow: 0 12px 36px rgba(180,130,10,0.18); }
body.light-mode .ucard-hi .ucard-title  { color: #6b4500; }
body.light-mode .ucard-hi .ucard-number { color: #9a7000; opacity: 0.75; }
body.light-mode .ucard-hi .ucard-icon-wrap { background: rgba(212,160,23,0.10); border-color: rgba(212,160,23,0.30); }

body.light-mode .ucard-lm {
  background: linear-gradient(155deg, #f5f2ff 0%, #ede8ff 100%);
  border-color: rgba(109,40,217,0.22);
}
body.light-mode .ucard-lm .ucard-overlay {
  background: linear-gradient(155deg, rgba(248,245,255,0.5) 0%, rgba(124,58,237,0.06) 100%);
}
body.light-mode .ucard-lm:hover { border-color: rgba(109,40,217,0.48); box-shadow: 0 12px 36px rgba(109,40,217,0.15); }
body.light-mode .ucard-lm .ucard-title  { color: #3b0f8c; }
body.light-mode .ucard-lm .ucard-number { color: #6030b0; opacity: 0.75; }
body.light-mode .ucard-lm .ucard-icon-wrap { background: rgba(124,58,237,0.10); border-color: rgba(124,58,237,0.28); }

/* بطاقة المراجعة الشاملة */
body.light-mode .ucard:not(.ucard-cw):not(.ucard-hi):not(.ucard-lm) {
  background: linear-gradient(155deg, #fffaf0 0%, #fff3dc 100%);
}

/* نصوص داخل البطاقات */
body.light-mode .ucard-sub { color: var(--text3); }
/* ── زر الرجوع ── */
body.light-mode .back-btn {
  background: #ffffff;
  border: 1.5px solid var(--border2);
  color: var(--text2);
  box-shadow: 0 1px 6px rgba(13,27,54,0.08);
}
body.light-mode .back-btn:hover {
  background: var(--surface2);
  border-color: var(--border3);
  color: var(--text);
  box-shadow: 0 3px 12px rgba(13,27,54,0.12);
}

/* ── بانر الوحدة ── */
body.light-mode .unit-hero { box-shadow: 0 4px 22px rgba(13,27,54,0.13); }
body.light-mode .uhero-hi .unit-hero-overlay  { background: linear-gradient(135deg, rgba(255,248,220,0.97), rgba(212,160,23,0.45)); }
body.light-mode .unit-hero-title { color: #0d1b36 !important; font-weight: 900; }
body.light-mode .unit-hero-meta  { color: var(--text3); }
body.light-mode .unit-hero-meta span { color: var(--text3); }

/* ── بطاقات الصعوبة ── */
body.light-mode .diff-label { color: var(--text3); letter-spacing: 1.4px; }
body.light-mode .dcard {
  background: #ffffff;
  border: 1.5px solid var(--border2);
  box-shadow: 0 2px 10px rgba(13,27,54,0.07);
}
body.light-mode .dcard:hover {
  background: var(--surface2);
  border-color: var(--border3);
  box-shadow: 0 6px 22px rgba(13,27,54,0.13);
  transform: translateY(-4px);
}
body.light-mode .dcard.picked {
  background: #f0f4ff;
  border-color: #1a2744;
  box-shadow: 0 0 0 3px rgba(26,39,68,0.10), 0 4px 16px rgba(13,27,54,0.13);
}
body.light-mode .dcard-title { color: var(--text); }
body.light-mode .dcard.picked .dcard-title { color: #0d1b36; }
body.light-mode .dcard-desc { color: var(--text3); }

/* ── شريط الاختبار ── */
body.light-mode .quiz-topbar {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 0.5rem 0.75rem;
}
body.light-mode .qc-score { background: rgba(160,100,0,0.10); border-color: rgba(160,100,0,0.30); color: #7a5000; }
body.light-mode .qc-count { background: #ffffff; border-color: var(--border2); color: var(--text2); }
body.light-mode .qc-timer { background: rgba(180,30,30,0.09); border-color: rgba(180,30,30,0.25); color: #951a1a; }

/* شريط التقدم */
body.light-mode .pbar { background: var(--surface3); }
body.light-mode .pstep { background: var(--surface3); }

/* ═══ بطاقة السؤال — الأهم ═══ */
body.light-mode .qcard {
  background: #ffffff;
  border: 1.5px solid var(--border2);
  box-shadow: 0 4px 24px rgba(13,27,54,0.10);
}
body.light-mode .qcard.state-ok {
  border-color: rgba(21,128,61,0.50);
  background: #f0fdf4;
