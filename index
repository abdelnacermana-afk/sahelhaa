// ═══════════════════════════════════════════
//  INJECT IMAGES AS BASE64
// ═══════════════════════════════════════════
(function(){
  const VS_B64 = "";
  const GANDHI_B64 = "";
  const FLAG_B64 = "";

  const applyBg = (id, b64, type) => {
    const el = document.getElementById(id);
    if (el) el.style.backgroundImage = `url(data:image/${type};base64,${b64})`;
  };

  applyBg('img-cw',    VS_B64,     'jpeg');
  applyBg('img-hi',    FLAG_B64,   'jpeg');
  applyBg('img-lm',    GANDHI_B64, 'jpeg');
  applyBg('uhero-img-dz', FLAG_B64, 'jpeg');
})();

// ═══════════════════════════════════════════
//  Arabic month names
// ═══════════════════════════════════════════
const AR_MONTHS = ['','جانفي','فيفري','مارس','أفريل','ماي','جوان','جويلية','أوت','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];

function formatDate(raw) {
  // raw may be:
  //   DD/MM/YYYY          → تاريخ عادي
  //   DD-DD/MM/YYYY       → فترة زمنية - نفس الشهر
  //   DD-DD/MM-MM/YYYY    → فترة زمنية - شهران مختلفان
  const slashParts = raw.split('/');

  // تاريخ عادي: DD/MM/YYYY
  if (slashParts.length === 3 && !slashParts[0].includes('-') && !slashParts[1].includes('-')) {
    const d = slashParts[0].replace(/^0/, '');
    const m = parseInt(slashParts[1], 10);
    const y = slashParts[2];
    return `${d} ${AR_MONTHS[m] || slashParts[1]} ${y}`;
  }

  // فترة زمنية: DD-DD/MM/YYYY أو DD-DD/MM-MM/YYYY
  if (slashParts.length === 3 && slashParts[0].includes('-')) {
    const days   = slashParts[0].split('-');
    const months = slashParts[1].split('-');
    const y  = slashParts[2];
    const d1 = days[0].replace(/^0/, '');
    const d2 = days[1] ? days[1].replace(/^0/, '') : null;
    const m1 = parseInt(months[0], 10);
    const m2 = months[1] ? parseInt(months[1], 10) : null;

    if (d2 && m2 && m2 !== m1) {
      // شهران مختلفان: 28 جانفي - 4 فيفري 1957
      return `${d1} ${AR_MONTHS[m1] || months[0]} - ${d2} ${AR_MONTHS[m2] || months[1]} ${y}`;
    } else if (d2) {
      // نفس الشهر: 18 - 24 أفريل 1955
      return `${d1} - ${d2} ${AR_MONTHS[m1] || slashParts[1]} ${y}`;
    }
  }

  return raw;
}

// ═══════════════════════════════════════════
//  DATA — per-unit structured data
// ═══════════════════════════════════════════
