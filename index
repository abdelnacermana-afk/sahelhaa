function makeDataArray(raw) {
  return raw.map(e => {
    const formatted = formatDate(e.date);
    const yr = parseInt(e.date.split('/')[2], 10);
    const branch = e.branch === 'literary' ? 'literary' : 'science';
    return { date: formatted, event: e.event, year: yr, close: [yr-1, yr+1], branch };
  });
}

